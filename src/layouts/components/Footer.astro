---
import profile from '@src/data/profile';
import site from '@src/data/site';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const today = new Date();

const defaultFooter = `Copyright © {year} ${site.title || 'Devolio'}. Template created by [Syakir @ Devaradise](https://devaradise.com)`;
const rawFooterText = (site.footer || defaultFooter).replace(/\{year\}/g, today.getFullYear().toString());

const mdProcessor = await createMarkdownProcessor();
const rawFooterHtml = (await mdProcessor.render(rawFooterText)).code;
const footerHtml = rawFooterHtml
	.replace(/^<p>/, '')
	.replace(/<\/p>\s*$/, '')
	.replace(/<a /g, '<a target="_blank" rel="nofollow noopener noreferrer" class="underline hover:text-zinc-800 dark:hover:text-zinc-200" ');

const socialItems = [
	{
		name: 'YouTube',
		url: profile.youtube,
		type: 'youtube'
	},
	{
		name: 'Instagram',
		url: profile.instagram,
		type: 'instagram'
	},
	{
		name: 'Facebook',
		url: profile.facebook,
		type: 'facebook'
	},
	{
		name: 'LinkedIn',
		url: profile.linkedin,
		type: 'linkedin'
	},
	{
		name: 'X (Twitter)',
		url: profile.twitter,
		type: 'twitter'
	},
	{
		name: 'Pinterest',
		url: profile.pinterest,
		type: 'pinterest'
	}
].filter((item) => Boolean(item.url));
---

<footer class='container mt-8'>
	{socialItems.length > 0 && (
		<div class='justify-center flex flex-wrap items-center gap-4 sm:gap-5 py-8'>
			{socialItems.map((item) => (
				<a
					href={item.url}
					target='_blank'
					rel='noopener noreferrer'
					aria-label={item.name}
					title={item.name}
					class='w-10 h-10 rounded-full bg-zinc-900 text-white hover:bg-black hover:scale-110 active:scale-95 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-all duration-200 inline-flex items-center justify-center shadow-sm'
				>
					{item.type === 'youtube' && (
						<svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='currentColor'>
							<path d='M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z'/>
						</svg>
					)}
					{item.type === 'instagram' && (
						<svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
							<rect width='20' height='20' x='2' y='2' rx='5' ry='5'/>
							<path d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z'/>
							<line x1='17.5' x2='17.51' y1='6.5' y2='6.5'/>
						</svg>
					)}
					{item.type === 'facebook' && (
						<svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='currentColor'>
							<path d='M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z'/>
						</svg>
					)}
					{item.type === 'linkedin' && (
						<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='currentColor'>
							<path d='M6.94 5a2 2 0 1 1-4-.002 2 2 0 0 1 4 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.68-2.91V8.48z'/>
						</svg>
					)}
					{item.type === 'twitter' && (
						<svg xmlns='http://www.w3.org/2000/svg' width='17' height='17' viewBox='0 0 24 24' fill='currentColor'>
							<path d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'/>
						</svg>
					)}
					{item.type === 'pinterest' && (
						<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='currentColor'>
							<path d='M12 0a12 12 0 0 0-4.37 23.18c-.07-.94-.13-2.39.03-3.42l1.19-5.05s-.3-.61-.3-1.51c0-1.42.82-2.48 1.85-2.48.87 0 1.29.65 1.29 1.44 0 .88-.56 2.19-.85 3.41-.24 1.02.51 1.85 1.52 1.85 1.82 0 3.22-1.92 3.22-4.69 0-2.45-1.76-4.17-4.28-4.17-2.92 0-4.63 2.19-4.63 4.45 0 .88.34 1.83.76 2.34a.31.31 0 0 1 .07.3c-.08.33-.26 1.05-.3 1.2-.05.2-.17.25-.39.15-1.44-.67-2.34-2.77-2.34-4.46 0-3.63 2.64-6.97 7.61-6.97 3.99 0 7.1 2.85 7.1 6.65 0 3.97-2.5 7.16-5.97 7.16-1.17 0-2.26-.61-2.64-1.32l-.72 2.74c-.26 1-.96 2.25-1.43 3.01A12 12 0 1 0 12 0z'/>
						</svg>
					)}
				</a>
			))}
		</div>
	)}

	<div class='py-6 border-t dark:border-t-zinc-700 text-center'>
		<div class='text-sm text-zinc-500 dark:text-zinc-400' set:html={footerHtml}></div>
	</div>
</footer>

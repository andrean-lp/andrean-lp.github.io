---
import HeaderLink from './HeaderLink.astro';
import profile from '@src/data/profile';
import GithubIcon from '@src/components/icons/GithubIcon.astro';
import { useTranslations, getSwitchLocaleUrl, type SupportedLocale } from '../../i18n/ui';

const githubUrl = profile.github || 'https://github.com/andrean-lp';

const currentLocale = (Astro.currentLocale || 'id') as SupportedLocale;
const t = useTranslations(currentLocale);

const currentPath = Astro.url.pathname;
const switchIdUrl = getSwitchLocaleUrl(currentPath, 'id');
const switchEnUrl = getSwitchLocaleUrl(currentPath, 'en');

const isEn = currentLocale === 'en';
const homeHref = isEn ? '/en/' : '/';
const aboutHref = isEn ? '/en/about/' : '/about/';
const projectsHref = isEn ? '/en/projects/' : '/projects/';
const postsHref = isEn ? '/en/posts/' : '/posts/';
const tagsHref = isEn ? '/en/tags/' : '/tags/';
---

<header
	id='site-header'
	class:list={[
		'flex items-center w-full transition duration-300 z-[999] border-[var(--soft-border-color)]'
	]}
>
	<div class='container'>
		<nav class='flex gap-4 items-center justify-between py-3'>
			<div class='flex items-center min-w-[44px]'>
				<!-- Avatar kiri telah dihapus sesuai permintaan -->
			</div>
			<div class='flex items-center gap-1.5'>
				<!-- Language Switcher Pill -->
				<div class="inline-flex items-center text-[11px] font-bold rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-100/90 dark:bg-zinc-800/90 p-0.5 shadow-2xs mr-1">
					<a
						href={switchIdUrl}
						class={`px-2 py-1 rounded-full transition-all duration-200 ${currentLocale === 'id' ? 'bg-primary text-white shadow-xs' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100'}`}
						aria-label="Bahasa Indonesia"
						title="Bahasa Indonesia"
					>
						ID
					</a>
					<a
						href={switchEnUrl}
						class={`px-2 py-1 rounded-full transition-all duration-200 ${currentLocale === 'en' ? 'bg-primary text-white shadow-xs' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100'}`}
						aria-label="English"
						title="English"
					>
						EN
					</a>
				</div>

				{githubUrl && (
					<a class='p-2 text-primary dark:text-white hover:opacity-80 active:scale-95 transition-all' href={githubUrl} target='_blank' rel='noopener noreferrer' aria-label='GitHub Profile'>
						<GithubIcon class='w-5 h-5' />
					</a>
				)}
				<button class='p-2 text-primary dark:text-white hover:opacity-80 active:scale-95 transition-all' id='themeToggle' aria-label='Theme mode'>
					<svg
						class='sun'
						xmlns='http://www.w3.org/2000/svg'
						width='22'
						height='22'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						stroke-linecap='round'
						stroke-linejoin='round'
						class='lucide lucide-sun'
						><circle cx='12' cy='12' r='4'></circle><path d='M12 2v2'></path><path d='M12 20v2'></path><path d='m4.93 4.93 1.41 1.41'
						></path><path d='m17.66 17.66 1.41 1.41'></path><path d='M2 12h2'></path><path d='M20 12h2'></path><path
							d='m6.34 17.66-1.41 1.41'></path><path d='m19.07 4.93-1.41 1.41'></path></svg
					>
					<svg
						class='moon'
						xmlns='http://www.w3.org/2000/svg'
						width='22'
						height='22'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						stroke-linecap='round'
						stroke-linejoin='round'
						class='lucide lucide-moon'
					>
						<path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'></path></svg
					>
				</button>
			</div>
		</nav>
    <div class='fixed top-3 w-auto max-w-full px-3 left-1/2 -translate-x-1/2 z-[999]'>
      <div class="flex px-2.5 bg-white/90 dark:bg-zinc-900/75 backdrop-blur-md leading-tight rounded-full border dark:border-zinc-700">
        <div class="px-2.5 text-sm">
          <HeaderLink class="py-3 flex items-center" href={homeHref} aria-label={t('nav.home')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          </HeaderLink>
        </div>
        <div class="px-2.5 text-sm">
          <HeaderLink class="py-3 flex items-center" href={aboutHref} aria-label={t('nav.about')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </HeaderLink>
        </div>
        <div class="px-2.5 text-sm">
          <HeaderLink class="py-3 flex items-center" href={projectsHref} aria-label={t('nav.projects')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
          </HeaderLink>
        </div>
        <div class="px-2.5 text-sm">
          <HeaderLink class="py-3 flex items-center" href={postsHref} aria-label={t('nav.posts')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-notebook-pen"><path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/></svg>
          </HeaderLink>
        </div>
        <div class="px-2.5 text-sm">
          <HeaderLink class="py-3 flex items-center" href={tagsHref} aria-label={t('nav.tags')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tags"><path d="M13.172 2a2 2 0 0 1 1.414.586l6.71 6.71a2.4 2.4 0 0 1 0 3.408l-4.592 4.592a2.4 2.4 0 0 1-3.408 0l-6.71-6.71A2 2 0 0 1 6 9.172V3a1 1 0 0 1 1-1z"/><path d="M2 7v6.172a2 2 0 0 0 .586 1.414l6.71 6.71a2.4 2.4 0 0 0 3.191.193"/><circle cx="10.5" cy="6.5" r=".5" fill="currentColor"/></svg>
          </HeaderLink>
        </div>
      </div>
    </div>
	</div>

	<style is:global>
		#themeToggle .moon {
			display: none;
		}
		.dark #themeToggle .sun {
			display: none;
		}
		.dark #themeToggle .moon {
			display: block;
		}
	</style>

	<script>
		function sendMessage(message: any) {
			const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
			if (!iframe) return;
			iframe.contentWindow?.postMessage({ giscus: message }, 'https://giscus.app');
		}

		const handleToggleClick = () => {
			const isDark = document.documentElement.classList.toggle('dark');
			sendMessage({ setConfig: { theme: isDark ? 'dark_dimmed' : 'light' } });
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		};

		document.getElementById('themeToggle')?.addEventListener('click', handleToggleClick);
	</script>
</header>

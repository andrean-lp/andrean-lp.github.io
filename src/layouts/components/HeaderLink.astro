---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;
const subpath = pathname.match(/[^\/]+/g);
const cleanHref = typeof href === 'string' ? href.replace(/\/$/, '') : href;
const cleanPath = pathname.replace(/\/$/, '');
const isActive = cleanHref === cleanPath || Boolean(subpath?.[0] && cleanHref === '/' + subpath[0]);
---

<a
	href={href}
	class:list={[
		className,
		'transition-all duration-200 border-b-2',
		{
			'border-primary text-primary font-semibold dark:border-white dark:text-white': isActive,
			'border-transparent text-zinc-400 hover:text-primary dark:text-white/80 dark:hover:text-white': !isActive
		}
	]}
	{...props}
>
	<slot />
</a>

---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import FloatingTelegramModal from '../components/widgets/FloatingTelegramModal.astro';
import site from '../data/site.json';

interface Props {
	title: string;
	description: string;
	image?: string;
	articleDate?: Date;
	updatedDate?: Date;
	type?: 'website' | 'article';
	tags?: string[];
	noindex?: boolean;
}

const { title, description, image, articleDate, updatedDate, type = 'website', tags, noindex = false } = Astro.props;
const currentLocale = Astro.currentLocale || 'id';
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			articleDate={articleDate}
			updatedDate={updatedDate}
			type={type}
			tags={tags}
			noindex={noindex}
		/>
	</head>
	<body
		class="bg-white dark:bg-zinc-900 dark:text-zinc-100 pt-16 sm:pt-0"
	>
		<Header/>
		<div class='py-8 min-h-[calc(100vh-160px)]'>
			<slot />
		</div>
		<Footer />
		<FloatingTelegramModal telegramUrl={site.telegram || "https://t.me/andrean_lp"} webhookUrl={site.leadWebhookUrl} lang={currentLocale as 'id' | 'en'} />
	</body>
</html>

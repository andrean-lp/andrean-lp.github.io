---
import digitalProductsData from '../data/digital_products.json';

const show = digitalProductsData.show ?? true;
const sectionTitle = digitalProductsData.sectionTitle || 'Digital Products';
const sectionSubtitle = digitalProductsData.sectionSubtitle || '';
const sectionCtaText = digitalProductsData.sectionCtaText || 'All Products';
const sectionCtaUrl = digitalProductsData.sectionCtaUrl || 'https://clicky.id/andrean-lp';
const products = digitalProductsData.products || [];

if (!show || products.length === 0) {
  return;
}
---

<div id="digital-products" class="mb-14 scroll-mt-20">
  <div class="flex justify-between items-center gap-2 mb-3">
    <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">{sectionTitle}</h2>
    {sectionCtaUrl && (
      <a 
        href={sectionCtaUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-primary text-white hover:opacity-90 active:scale-[0.98] transition-all duration-200 shadow-2xs hover:shadow-xs group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-80 group-hover:scale-110 transition-transform">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <path d="M3 6h18"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span>{sectionCtaText}</span>
      </a>
    )}
  </div>

  {sectionSubtitle && (
    <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mb-5 -mt-1">
      {sectionSubtitle}
    </p>
  )}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {products.map((prod) => (
      <div class="group block p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-zinc-200/90 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 shadow-xs hover:shadow-xl dark:hover:border-zinc-700/80 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
        <div>
          <!-- Thumbnail / Cover Image -->
          <div class="relative w-full aspect-[16/10] rounded-xl sm:rounded-2xl overflow-hidden bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-100 dark:border-zinc-800/80 mb-4">
            {prod.image ? (
              <img 
                src={prod.image} 
                alt={prod.title} 
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" 
                loading="lazy" 
                decoding="async" 
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-zinc-100 dark:bg-zinc-800 text-zinc-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                  <circle cx="9" cy="9" r="2"/>
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                </svg>
              </div>
            )}
            
            {prod.badge && (
              <div class="absolute top-2.5 left-2.5">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-white/95 dark:bg-zinc-900/90 text-zinc-800 dark:text-zinc-200 shadow-xs border border-zinc-200/70 dark:border-zinc-700/70 backdrop-blur-xs">
                  {prod.badge}
                </span>
              </div>
            )}
          </div>

          <!-- Product Title & Description -->
          <h3 class="font-bold text-base text-zinc-900 dark:text-zinc-100 group-hover:text-primary transition-colors mb-2 line-clamp-2">
            {prod.title}
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 line-clamp-3 mb-4 leading-relaxed">
            {prod.description}
          </p>
        </div>

        <!-- CTA Button -->
        <div class="pt-3.5 border-t border-zinc-100 dark:border-zinc-800/80 mt-2">
          <a 
            href={prod.buyUrl || '#'} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-primary text-white hover:opacity-90 active:scale-[0.98] transition-all duration-200 shadow-2xs hover:shadow-xs group/btn"
          >
            <span>{prod.ctaText || 'Buy Now'}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-80 group-hover/btn:translate-x-0.5 transition-transform">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</div>

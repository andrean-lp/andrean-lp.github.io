---
import { slugify } from '../utils';
import FormattedDate from './FormattedDate.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type BlogPost = CollectionEntry<'blog'>;
const { post }: Record<string, any> | { post: BlogPost } = Astro.props;
const coverImage = post.data.coverImage;
---

<div class='flex gap-3 sm:gap-4 items-center border-b py-3 mb-1 dark:border-b-zinc-700'>
  <a href={`/${post.id}/`} class='shrink-0 block overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800 w-20 h-14 sm:w-24 sm:h-16 group'>
    {coverImage ? (
      typeof coverImage === 'string' ? (
        <img
          src={coverImage}
          alt={post.data.title}
          width={96}
          height={64}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <Image
          src={coverImage}
          alt={post.data.title}
          width={192}
          height={128}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      )
    ) : (
      <div class="w-full h-full flex items-center justify-center text-zinc-400 dark:text-zinc-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
  </a>

  <div class='grow min-w-0'>
    <h3 class='font-medium text-base sm:text-lg leading-snug'>
      <a href={`/${post.id}/`} class='hover:underline hover:text-[var(--link-color)] transition-colors line-clamp-2'>
        {post.data.title}
      </a>
    </h3>
    <div class='text-zinc-500 dark:text-zinc-400 text-xs sm:text-sm mt-1 flex flex-wrap items-center gap-2'>
      <FormattedDate date={post.data.pubDate} />
      {post.data.tags && post.data.tags.length > 0 && (
        <span class='sm:hidden inline-flex items-center gap-1.5 text-zinc-400 dark:text-zinc-500'>
          <span>•</span>
          {post.data.tags.slice(0, 2).map((tag: string) => (
            <a
              class='text-xs underline text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200'
              href={`/tags/${slugify(tag)}`}>
              {tag}
            </a>
          ))}
        </span>
      )}
    </div>
  </div>

  <div class='hidden sm:flex gap-2 shrink-0'>
    {
      (post.data.tags || [] )?.map((tag: string) => (
        <a
          class='border border-zinc-300 dark:border-zinc-700 rounded-2xl
          text-sm text-zinc-700 dark:text-zinc-300 no-underline px-2 py-0.5
          transition-all duration-700
          hover:border-zinc-700 dark:hover:border-zinc-300'
          href={`/tags/${slugify(tag)}`}>
          {tag}
        </a>
      ))
    }
  </div>
</div>
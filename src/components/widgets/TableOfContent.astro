---
const { headings, maxLevel = 3 } = Astro.props;
const toc = buildToc(headings);

function buildToc(headings: any) {
	const _toc: any = [];
	const parentHeadings = new Map();
	(headings || []).forEach((h: any) => {
		const heading = { ...h, subheadings: [] };
		parentHeadings.set(heading.depth, heading);
		if (heading.depth === 2) {
			_toc.push(heading);
		} else {
			if (maxLevel > 2) {
				parentHeadings.get(heading.depth - 1)?.subheadings?.push(heading);
			}
		}
	});
	return _toc;
}
---

{toc.length > 0 && (
	<nav class='toc sticky top-8 py-2'>
		<h3 class='text-xs font-bold tracking-wider text-zinc-400 dark:text-zinc-500 uppercase mb-4'>
			Daftar Isi
		</h3>
		<ul class='toc-list border-l border-zinc-200 dark:border-zinc-800 max-h-[calc(100vh-100px)] overflow-y-auto space-y-1'>
			{
				toc.map((heading: any) => (
					<li>
						<a
							class='toc-link block text-sm leading-snug py-1.5 pl-4 pr-2 -ml-[1px] border-l-2'
							href={'#' + heading.slug}>
							{heading.text}
						</a>
						{heading.subheadings?.length > 0 && (
							<ul class='space-y-1'>
								{heading.subheadings.map((subheading: any) => (
									<li>
										<a
											class='toc-link block text-xs leading-snug py-1.5 pl-7 pr-2 -ml-[1px] border-l-2'
											href={'#' + subheading.slug}>
											{subheading.text}
										</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))
			}
		</ul>
	</nav>
)}

<style>
	.toc-link {
		border-left-color: transparent;
		color: #71717a; /* text-zinc-500 */
		text-decoration: none;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	:global(.dark) .toc-link {
		color: #a1a1aa; /* text-zinc-400 */
	}
	.toc-link:hover {
		color: #18181b; /* text-zinc-900 */
	}
	:global(.dark) .toc-link:hover {
		color: #fafafa; /* text-zinc-50 */
	}
	.toc-link.is-active {
		border-left-color: var(--primary-color, #2563eb) !important;
		color: var(--primary-color, #2563eb) !important;
		font-weight: 600 !important;
	}
	:global(.dark) .toc-link.is-active {
		border-left-color: var(--primary-color, #3b82f6) !important;
		color: var(--primary-color, #3b82f6) !important;
	}

	.toc-list::-webkit-scrollbar {
		width: 4px;
	}
	.toc-list::-webkit-scrollbar-track {
		background: transparent;
	}
	.toc-list::-webkit-scrollbar-thumb {
		background: #e4e4e7;
		border-radius: 4px;
	}
	:global(.dark) .toc-list::-webkit-scrollbar-thumb {
		background: #27272a;
		border-radius: 4px;
	}
</style>

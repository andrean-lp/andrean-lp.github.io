---
// TestimonialCard: Kartu testimoni masonry dengan rasio dinamis ala Pinterest
interface Props {
  testimonial: {
    id?: string;
    title: string;
    clientName?: string;
    roleOrCompany?: string;
    category?: string;
    image: string;
    highlight?: string;
    rating?: number;
    date?: string;
  };
  index: number;
}

const { testimonial, index } = Astro.props;

const stars = Math.max(1, Math.min(5, Number(testimonial.rating) || 5));
---

<div 
  class="testimonial-card break-inside-avoid mb-5 group cursor-pointer"
  data-category={testimonial.category || 'Lainnya'}
  data-index={index}
  data-testimonial={JSON.stringify(testimonial)}
>
  <div class="rounded-2xl sm:rounded-3xl overflow-hidden border border-zinc-200/90 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 shadow-xs hover:shadow-xl dark:hover:border-zinc-700/80 transition-all duration-300 hover:-translate-y-1 flex flex-col">
    
    <!-- Image Showcase with Hover Zoom Indicator -->
    <div class="relative overflow-hidden bg-zinc-100 dark:bg-zinc-800/60">
      <img 
        src={testimonial.image} 
        alt={testimonial.title || 'Bukti Testimoni Klien'}
        class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        loading="lazy"
        decoding="async"
      />

      <!-- Hover Overlay Badge: Klik untuk Zoom -->
      <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center p-4">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white/95 dark:bg-zinc-900/95 text-zinc-900 dark:text-white rounded-full text-xs font-semibold shadow-lg backdrop-blur-xs scale-90 group-hover:scale-100 transition-transform duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <span>Klik untuk Zoom</span>
        </span>
      </div>

      <!-- Category Pill Badge -->
      {testimonial.category && (
        <span class="absolute top-3 left-3 px-2.5 py-1 bg-black/60 text-white backdrop-blur-md rounded-full text-[11px] font-semibold tracking-wide shadow-sm border border-white/20">
          {testimonial.category}
        </span>
      )}
    </div>

    <!-- Content & Meta Information -->
    <div class="p-4 sm:p-5 flex flex-col flex-grow justify-between">
      <div>
        <!-- Star Rating -->
        <div class="flex items-center gap-0.5 text-amber-400 mb-2">
          {Array.from({ length: stars }).map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          ))}
        </div>

        <!-- Title -->
        <h3 class="font-bold text-base text-zinc-900 dark:text-zinc-100 group-hover:text-primary transition-colors leading-snug">
          {testimonial.title}
        </h3>

        <!-- Highlight Quote -->
        {testimonial.highlight && (
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed italic line-clamp-3">
            "{testimonial.highlight}"
          </p>
        )}
      </div>

      <!-- Client Author Info -->
      {(testimonial.clientName || testimonial.roleOrCompany) && (
        <div class="pt-3 mt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
          <div>
            {testimonial.clientName && (
              <span class="font-semibold text-zinc-800 dark:text-zinc-200 block">
                {testimonial.clientName}
              </span>
            )}
            {testimonial.roleOrCompany && (
              <span class="text-[11px] text-zinc-500 dark:text-zinc-400">
                {testimonial.roleOrCompany}
              </span>
            )}
          </div>

          <div class="shrink-0 opacity-60 group-hover:opacity-100 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
              <path d="M15 3h6v6"></path>
              <path d="M10 14 21 3"></path>
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            </svg>
          </div>
        </div>
      )}
    </div>
  </div>
</div>

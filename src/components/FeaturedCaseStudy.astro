---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import featuredData from '../data/featured_case_study.json';

const show = featuredData.show ?? true;
const sectionTitle = featuredData.sectionTitle || 'Featured Case Studies';

// Mendukung format list baru maupun format single object lama
const rawProjects = (featuredData as any).projects || ((featuredData as any).title ? [featuredData] : []);

if (!show || rawProjects.length === 0) {
  return;
}

const mdProcessor = await createMarkdownProcessor();

const projects = await Promise.all(
  rawProjects.map(async (p: any) => {
    return {
      title: p.title || '',
      coverImage: p.coverImage || '',
      detailsLink: p.detailsLink || '#',
      previewLink: p.previewLink || '',
      problemHtml: p.problem ? (await mdProcessor.render(p.problem)).code : '',
      solutionHtml: p.solution ? (await mdProcessor.render(p.solution)).code : '',
      impactHtml: p.impact ? (await mdProcessor.render(p.impact)).code : '',
      technologies: (p.technologies || [])
        .map((t: any) => (typeof t === 'string' ? t : t?.name || ''))
        .filter(Boolean),
    };
  })
);
---

<div class="mt-6 mb-14">
  <div class="flex justify-between gap-2 mb-6">
    <h2 class="text-lg font-bold">{sectionTitle}</h2>
  </div>

  <div class={`grid grid-cols-1 ${projects.length > 1 ? 'lg:grid-cols-2' : ''} gap-6 lg:gap-8`}>
    {projects.map((proj) => (
      <div class="bg-[#F5F5F7] dark:bg-zinc-900/50 border border-zinc-200/80 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-200 hover:border-zinc-300 dark:hover:border-zinc-700">
        <div>
          <!-- Header -->
          <div class="mb-5">
            <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{proj.title}</h3>
          </div>

          <!-- Cover Image -->
          {proj.coverImage && (
            <div class="mb-6 rounded-2xl overflow-hidden bg-zinc-200 dark:bg-zinc-800 aspect-video w-full">
              <img 
                src={proj.coverImage} 
                alt={`${proj.title} Cover`} 
                class="w-full h-full object-cover" 
                loading="lazy" 
              />
            </div>
          )}

          <!-- Content Sections: Problem, Solution, Impact -->
          <div class="space-y-6">
            {proj.problemHtml && (
              <section>
                <h4 class="text-xs font-bold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase mb-2">Problem</h4>
                <div class="prose prose-sm prose-zinc dark:prose-invert max-w-none prose-p:leading-relaxed" set:html={proj.problemHtml} />
              </section>
            )}

            {proj.solutionHtml && (
              <section>
                <h4 class="text-xs font-bold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase mb-2">Solution</h4>
                <div class="prose prose-sm prose-zinc dark:prose-invert max-w-none prose-p:leading-relaxed" set:html={proj.solutionHtml} />
              </section>
            )}

            {proj.impactHtml && (
              <section>
                <h4 class="text-xs font-bold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase mb-2">Impact</h4>
                <div class="prose prose-sm prose-zinc dark:prose-invert max-w-none prose-p:leading-relaxed" set:html={proj.impactHtml} />
              </section>
            )}
          </div>
        </div>

        <div>
          <!-- Technologies / Tools -->
          {proj.technologies.length > 0 && (
            <div class="pt-6 mt-6 border-t border-zinc-200/80 dark:border-zinc-800">
              <h4 class="text-xs font-bold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase mb-3">Technologies / Tools</h4>
              <ul class="flex flex-wrap gap-2">
                {proj.technologies.map((tech: string) => (
                  <li class="px-2.5 py-1 bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60 text-xs rounded-lg font-medium shadow-xs">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Action Buttons: Details (Putih) & Live Preview (Hitam) -->
          <div class="pt-6 mt-6 border-t border-zinc-200/80 dark:border-zinc-800 flex items-center gap-3">
            <a 
              href={proj.detailsLink || '#'} 
              class="flex-1 text-center py-2.5 px-4 rounded-xl font-semibold text-sm bg-white text-zinc-900 border border-zinc-300/90 shadow-xs hover:bg-zinc-100 hover:border-zinc-400 active:scale-[0.98] transition-all duration-200 dark:bg-zinc-800 dark:text-white dark:border-zinc-700 dark:hover:bg-zinc-700 inline-flex items-center justify-center"
            >
              Details
            </a>
            <a 
              href={proj.previewLink || '#'} 
              target={proj.previewLink && proj.previewLink !== '#' ? '_blank' : '_self'}
              rel={proj.previewLink && proj.previewLink !== '#' ? 'noopener noreferrer' : undefined}
              class="flex-1 text-center py-2.5 px-4 rounded-xl font-semibold text-sm bg-black text-white shadow-xs hover:bg-zinc-800 active:scale-[0.98] transition-all duration-200 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200 inline-flex items-center justify-center gap-1.5"
            >
              <span>Live Preview</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-80">
                <path d="M15 3h6v6"></path>
                <path d="M10 14 21 3"></path>
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

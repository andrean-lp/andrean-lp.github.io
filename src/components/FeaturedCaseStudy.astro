---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import featuredCaseStudy from '../data/featured_case_study.json';

const {
  show,
  title,
  coverImage,
  intro,
  problem,
  solution,
  impact,
  technologies
} = featuredCaseStudy;

// Don't render anything if 'show' is false
if (!show) {
  return;
}

const mdProcessor = await createMarkdownProcessor();

const problemHtml = problem ? (await mdProcessor.render(problem)).code : '';
const solutionHtml = solution ? (await mdProcessor.render(solution)).code : '';
const impactHtml = impact ? (await mdProcessor.render(impact)).code : '';
---

<div class="mt-12 mb-12">
  <div class="flex justify-between gap-2 mb-6">
    <h2 class="text-lg font-bold">Featured Case Study</h2>
  </div>

  <div class="bg-zinc-100 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 md:p-10 overflow-hidden">
    <!-- Header -->
    <div class="mb-8">
      <h3 class="text-3xl md:text-5xl font-bold mb-4">{title}</h3>
      {intro && <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">{intro}</p>}
    </div>

    <!-- Cover Image -->
    {coverImage && (
      <div class="mb-12 rounded-2xl overflow-hidden bg-zinc-200 dark:bg-zinc-800 aspect-video w-full">
        <img 
          src={coverImage} 
          alt={`${title} Cover`} 
          class="w-full h-full object-cover" 
          loading="lazy" 
        />
      </div>
    )}

    <!-- Content Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <!-- Main Content (Problem, Solution, Impact) -->
      <div class="md:col-span-2 space-y-10">
        {problem && (
          <section>
            <h4 class="text-sm font-semibold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase mb-3">Problem</h4>
            <div class="prose prose-zinc dark:prose-invert max-w-none prose-p:leading-relaxed" set:html={problemHtml} />
          </section>
        )}

        {solution && (
          <section>
            <h4 class="text-sm font-semibold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase mb-3">Solution</h4>
            <div class="prose prose-zinc dark:prose-invert max-w-none prose-p:leading-relaxed" set:html={solutionHtml} />
          </section>
        )}

        {impact && (
          <section>
            <h4 class="text-sm font-semibold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase mb-3">Impact</h4>
            <div class="prose prose-zinc dark:prose-invert max-w-none prose-p:leading-relaxed" set:html={impactHtml} />
          </section>
        )}
      </div>

      <!-- Sidebar (Technologies) -->
      <div>
        {technologies && technologies.length > 0 && (
          <section class="bg-white dark:bg-zinc-900 rounded-2xl p-6 border border-zinc-200 dark:border-zinc-800">
            <h4 class="text-sm font-semibold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase mb-4">Technologies / Tools</h4>
            <ul class="flex flex-wrap gap-2">
              {technologies.map((tech) => (
                <li class="px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-300 text-sm rounded-lg font-medium">
                  {tech.name}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </div>
</div>

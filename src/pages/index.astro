---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '../components/Prose.astro';
import { projects } from '../data/projects';
import ProjectList from '../components/ProjectList.astro'
import PostItem from '../components/PostItem.astro';
import profile from '../data/profile';
import Schema from '../components/Schema.astro';
import FeaturedCaseStudy from '../components/FeaturedCaseStudy.astro';
import FaqSection from '../components/FaqSection.astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

type BlogPost = CollectionEntry<'blog'>;

const top6Projects = projects.slice(0, 6);
const posts = (await getCollection('blog')).sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);

const mdProcessor = await createMarkdownProcessor();
const rawBioHtml = (await mdProcessor.render(profile.bio || '')).code;
const bioHtml = rawBioHtml.replace(/<a /g, '<a target="_blank" rel="noopener noreferrer" ');
const siteTitle = SITE_TAGLINE ? `${SITE_TITLE} - ${SITE_TAGLINE}` : SITE_TITLE;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://andrean-lp.github.io';

// Schema.org: WebSite
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"description": SITE_DESCRIPTION,
	"url": siteUrl,
	"inLanguage": "id",
	"publisher": {
		"@type": "Person",
		"name": profile.name || SITE_TITLE,
		"url": `${siteUrl}/about/`,
	}
};

// Schema.org: Person (pemilik website)
const sameAs = [
	profile.github,
	profile.linkedin,
	profile.youtube,
	profile.instagram,
	profile.facebook,
	profile.pinterest,
].filter(Boolean);

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": profile.name || SITE_TITLE,
	"url": `${siteUrl}/about/`,
	"image": profile.avatar ? new URL(profile.avatar, Astro.site).toString() : undefined,
	"jobTitle": profile.role || undefined,
	"sameAs": sameAs.length > 0 ? sameAs : undefined,
};
---

<BaseLayout title={siteTitle} description={SITE_DESCRIPTION}>
	<Schema item={websiteSchema} />
	<Schema item={personSchema} />
	<div class='container'>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
      <div class="text-pretty leading-9">
        <h1 class="text-4xl font-bold mb-4">{profile.headline || "Halo! Saya Andre Wahyu Hermawan 👋"}</h1>
        <Prose>
          <div class="text-lg space-y-4" set:html={bioHtml}></div>
        </Prose>
      </div>
      {profile.avatar ? (
        <img 
          src={profile.avatar} 
          alt={profile.name || "Foto Profil"} 
          width="300" 
          height="300" 
          loading="eager" 
          fetchpriority="high" 
          decoding="async" 
          class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover"
        />
      ) : (
        <Image 
          src={Ava} 
          alt={profile.name || "Andre Wahyu Hermawan"} 
          width={300} 
          height={300} 
          densities={[1, 1.5, 2]} 
          loading="eager" 
          decoding="async" 
          fetchpriority="high" 
          class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover"
        />
      )}
		</div>
		<main>
      <FeaturedCaseStudy />

      <div class="mb-14">
        <div class="flex justify-between items-center gap-2 mb-3">
          <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">Client Project</h2>
          <a 
            href="/projects/" 
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-primary text-white hover:opacity-90 active:scale-[0.98] transition-all duration-200 shadow-2xs hover:shadow-xs group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-80 group-hover:scale-110 transition-transform">
              <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
            </svg>
            <span>All Projects</span>
          </a>
        </div>
        <ProjectList projects={top6Projects}/>
      </div>

      <div class="mb-14">
        <div class="flex justify-between items-center gap-2 border-b pb-3 mb-2 dark:border-b-zinc-700">
          <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">They Ask You Answer</h2>
          <a 
            href="/posts/" 
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-primary text-white hover:opacity-90 active:scale-[0.98] transition-all duration-200 shadow-2xs hover:shadow-xs group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-80 group-hover:scale-110 transition-transform">
              <path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/>
              <path d="M2 6h4"/>
              <path d="M2 10h4"/>
              <path d="M2 14h4"/>
              <path d="M2 18h4"/>
              <path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/>
            </svg>
            <span>All Questions</span>
          </a>
        </div>
        <div>
          {
            posts.map((post: BlogPost) => (
              <PostItem post={post} />
            ))
          }      
        </div>
        <div class="text-right">
        </div>
      </div>

      <!-- FAQ Section (AEO, GEO, and Schema.org FAQPage) -->
      <FaqSection />
		</main>
	</div>
</BaseLayout>

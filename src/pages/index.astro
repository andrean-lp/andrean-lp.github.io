---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '../components/Prose.astro';
import { projects } from '../data/projects';
import ProjectList from '../components/ProjectList.astro'
import PostItem from '../components/PostItem.astro';
import profile from '../data/profile';
import Schema from '../components/Schema.astro';
import FeaturedCaseStudy from '../components/FeaturedCaseStudy.astro';
import FaqSection from '../components/FaqSection.astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

type BlogPost = CollectionEntry<'blog'>;

const top6Projects = projects.slice(0, 6);
const posts = (await getCollection('blog')).sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);

const mdProcessor = await createMarkdownProcessor();
const rawBioHtml = (await mdProcessor.render(profile.bio || '')).code;
const bioHtml = rawBioHtml.replace(/<a /g, '<a target="_blank" rel="noopener noreferrer" ');
const siteTitle = SITE_TAGLINE ? `${SITE_TITLE} - ${SITE_TAGLINE}` : SITE_TITLE;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://andrean-lp.github.io';

// Schema.org: WebSite
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"description": SITE_DESCRIPTION,
	"url": siteUrl,
	"inLanguage": "id",
	"publisher": {
		"@type": "Person",
		"name": profile.name || SITE_TITLE,
		"url": `${siteUrl}/about/`,
	}
};

// Schema.org: Person (pemilik website)
const sameAs = [
	profile.github,
	profile.linkedin,
	profile.youtube,
	profile.instagram,
	profile.facebook,
	profile.pinterest,
].filter(Boolean);

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": profile.name || SITE_TITLE,
	"url": `${siteUrl}/about/`,
	"image": profile.avatar ? new URL(profile.avatar, Astro.site).toString() : undefined,
	"jobTitle": profile.role || undefined,
	"sameAs": sameAs.length > 0 ? sameAs : undefined,
};
---

<BaseLayout title={siteTitle} description={SITE_DESCRIPTION}>
	<Schema item={websiteSchema} />
	<Schema item={personSchema} />
	<div class='container'>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
      <div class="text-pretty leading-9">
        <h1 class="text-4xl font-bold mb-4">{profile.headline || "Hi There 👋, Syakir Here!"}</h1>
        <Prose>
          <div class="text-lg space-y-4" set:html={bioHtml}></div>
        </Prose>
      </div>
      {profile.avatar ? (
        <img 
          src={profile.avatar} 
          alt={profile.name || "Foto Profil"} 
          width="300" 
          height="300" 
          loading="eager" 
          fetchpriority="high" 
          decoding="async" 
          class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover"
        />
      ) : (
        <Image 
          src={Ava} 
          alt={profile.name || "Muhammad Syakirurohman"} 
          width={300} 
          height={300} 
          densities={[1, 1.5, 2]} 
          loading="eager" 
          decoding="async" 
          fetchpriority="high" 
          class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover"
        />
      )}
		</div>
		<main>
      <FeaturedCaseStudy />

      <div class="mb-14">
        <div class="flex justify-between gap-2 mb-1">
          <h2 class="text-lg font-bold mb-3">Client Project</h2>
          <a href="/projects/" class="inline-block py-2 underline dark:prose-invert">All projects &raquo;</a>
        </div>
        <ProjectList projects={top6Projects}/>
      </div>

      <div class="mb-14">
        <div class="flex justify-between gap-2 border-b mb-1 dark:border-b-zinc-700">
          <h2 class="text-lg font-bold mb-3">Recent Posts</h2>
          <a href="/posts/" class="inline-block py-2 underline dark:prose-invert">All posts &raquo;</a>
        </div>
        <div>
          {
            posts.map((post: BlogPost) => (
              <PostItem post={post} />
            ))
          }      
        </div>
        <div class="text-right">
        </div>
      </div>

      <!-- FAQ Section (AEO, GEO, and Schema.org FAQPage) -->
      <FaqSection />
		</main>
	</div>
</BaseLayout>

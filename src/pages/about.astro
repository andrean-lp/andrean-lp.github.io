---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '../components/Prose.astro';
import Schema from '../components/Schema.astro';
import profile from '../data/profile';
import about from '../data/about.json';
import { SITE_TITLE } from '../consts';
import { renderMarkdown } from '../utils';

const rawShortDescHtml = await renderMarkdown(about.shortDesc || '');
const shortDescHtml = rawShortDescHtml.replace(/<a /g, '<a target="_blank" rel="noopener noreferrer" ');
const rawContentHtml = await renderMarkdown(about.content || '');
const contentHtml = rawContentHtml.replace(/<a /g, '<a target="_blank" rel="noopener noreferrer" ');

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://andrean-lp.github.io';
const aboutDescription = about.shortDesc ? about.shortDesc.replace(/<[^>]*>?/gm, '').substring(0, 160) : (profile.role
	? `${profile.name || SITE_TITLE} — ${profile.role}. Portfolio dan blog personal.`
	: `Tentang ${profile.name || SITE_TITLE}. Portfolio dan blog personal.`);

// Schema.org: Person (ProfilePage)
const sameAs = [
	profile.github,
	profile.linkedin,
	profile.youtube,
	profile.instagram,
	profile.facebook,
	profile.pinterest,
].filter(Boolean);

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": profile.name || SITE_TITLE,
	"url": `${siteUrl}/about/`,
	"image": profile.avatar ? new URL(profile.avatar, Astro.site).toString() : undefined,
	"jobTitle": profile.role || undefined,
	"description": aboutDescription,
	"sameAs": sameAs.length > 0 ? sameAs : undefined,
	"mainEntityOfPage": {
		"@type": "ProfilePage",
		"@id": `${siteUrl}/about/`,
	},
};

// Schema.org: BreadcrumbList
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl,
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "About",
			"item": `${siteUrl}/about/`,
		}
	]
};
---

<BaseLayout
	title={about.title || "About Me"}
	description={aboutDescription}
>
	<Schema item={personSchema} />
	<Schema item={breadcrumbSchema} />
  <div class='container'>
		<main class='prose text-lg dark:prose-invert'>
      <article>
        <div class='w-full md:flex md:items-center gap-16 mb-10'>
          <div class="text-pretty leading-9">
            <h1 class="text-4xl font-bold mb-4">{about.title || "Tentang Saya"}</h1>
            <Prose>
              <div class="text-lg space-y-4" set:html={shortDescHtml}></div>
            </Prose>
          </div>
          {profile.avatar ? (
            <img 
              src={profile.avatar} 
              alt={profile.name || "Foto Profil"} 
              width="300" 
              height="300" 
              loading="eager" 
              fetchpriority="high" 
              decoding="async" 
              class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover"
            />
          ) : (
            <Image 
              src={Ava} 
              alt={profile.name || "Andre Wahyu Hermawan"} 
              width={300} 
              height={300} 
              densities={[1, 1.5, 2]} 
              loading="eager" 
              decoding="async" 
              fetchpriority="high" 
              class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover"
            />
          )}
        </div>     
        <div>
          <Prose>
            <div class="text-lg space-y-4" set:html={contentHtml}></div>
          </Prose>
        </div>

        {about.mentors && about.mentors.length > 0 && (
          <div class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800 not-prose">
            <div class="mb-8">
              <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100">
                {about.mentorsTitle || "Tokoh Sumber Referensi"}
              </h2>
              {about.mentorsSubtitle && (
                <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
                  {about.mentorsSubtitle}
                </p>
              )}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {about.mentors.map((mentor: any) => {
                const initials = mentor.name
                  ? mentor.name
                      .split(/[\s/]+/)
                      .filter(Boolean)
                      .slice(0, 2)
                      .map((n: string) => n[0])
                      .join('')
                      .toUpperCase()
                  : '?';

                return (
                  <div class="p-5 sm:p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/40 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all flex items-start gap-4 sm:gap-5 shadow-2xs">
                    {/* Foto Tokoh / Avatar Inisial */}
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full overflow-hidden bg-primary/10 border-2 border-primary/20 flex items-center justify-center shrink-0 text-primary font-bold text-base sm:text-lg select-none shadow-xs">
                      {mentor.photo && mentor.photo.trim() !== '' ? (
                        <img 
                          src={mentor.photo} 
                          alt={mentor.name} 
                          width="64" 
                          height="64" 
                          loading="lazy" 
                          decoding="async" 
                          class="w-full h-full object-cover"
                        />
                      ) : (
                        <span>{initials}</span>
                      )}
                    </div>

                    {/* Informasi Tokoh */}
                    <div class="grow min-w-0">
                      {/* Nama Tokoh (Bold) */}
                      <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 leading-snug">
                        {mentor.name}
                      </h3>
                      {/* Profesi / Bidang Keahlian */}
                      {mentor.role && (
                        <p class="text-xs sm:text-sm font-semibold text-primary mt-1 mb-2">
                          {mentor.role}
                        </p>
                      )}
                      {/* Keterangan Alasan Rujukan */}
                      {mentor.reason && (
                        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                          {mentor.reason}
                        </p>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </article>
    </main>
  </div>
</BaseLayout>

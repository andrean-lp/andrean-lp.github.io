---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '../components/Prose.astro';
import Schema from '../components/Schema.astro';
import profile from '../data/profile';
import about from '../data/about.json';
import { SITE_TITLE } from '../consts';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const mdProcessor = await createMarkdownProcessor();
const rawShortDescHtml = (await mdProcessor.render(about.shortDesc || '')).code;
const shortDescHtml = rawShortDescHtml.replace(/<a /g, '<a target="_blank" rel="noopener noreferrer" ');
const rawContentHtml = (await mdProcessor.render(about.content || '')).code;
const contentHtml = rawContentHtml.replace(/<a /g, '<a target="_blank" rel="noopener noreferrer" ');

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://andrean-lp.github.io';
const aboutDescription = about.shortDesc ? about.shortDesc.replace(/<[^>]*>?/gm, '').substring(0, 160) : (profile.role
	? `${profile.name || SITE_TITLE} — ${profile.role}. Portfolio dan blog personal.`
	: `Tentang ${profile.name || SITE_TITLE}. Portfolio dan blog personal.`);

// Schema.org: Person (ProfilePage)
const sameAs = [
	profile.github,
	profile.linkedin,
	profile.youtube,
	profile.instagram,
	profile.facebook,
	profile.pinterest,
].filter(Boolean);

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": profile.name || SITE_TITLE,
	"url": `${siteUrl}/about/`,
	"image": profile.avatar ? new URL(profile.avatar, Astro.site).toString() : undefined,
	"jobTitle": profile.role || undefined,
	"description": aboutDescription,
	"sameAs": sameAs.length > 0 ? sameAs : undefined,
	"mainEntityOfPage": {
		"@type": "ProfilePage",
		"@id": `${siteUrl}/about/`,
	},
};

// Schema.org: BreadcrumbList
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl,
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "About",
			"item": `${siteUrl}/about/`,
		}
	]
};
---

<BaseLayout
	title={about.title || "About Me"}
	description={aboutDescription}
>
	<Schema item={personSchema} />
	<Schema item={breadcrumbSchema} />
  <div class='container'>
		<main class='prose text-lg dark:prose-invert'>
      <article>
        <div class='w-full md:flex md:items-center gap-16 mb-10'>
          <div class="text-pretty leading-9">
            <h1 class="text-4xl font-bold mb-4">{about.title || "Tentang Saya"}</h1>
            <Prose>
              <div class="text-lg space-y-4" set:html={shortDescHtml}></div>
            </Prose>
          </div>
          {profile.avatar ? (
            <img 
              src={profile.avatar} 
              alt={profile.name || "Foto Profil"} 
              width="300" 
              height="300" 
              loading="eager" 
              fetchpriority="high" 
              decoding="async" 
              class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover"
            />
          ) : (
            <Image 
              src={Ava} 
              alt={profile.name || "Andre Wahyu Hermawan"} 
              width={300} 
              height={300} 
              densities={[1, 1.5, 2]} 
              loading="eager" 
              decoding="async" 
              fetchpriority="high" 
              class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover"
            />
          )}
        </div>     
        <div>
          <Prose>
            <div class="text-lg space-y-4" set:html={contentHtml}></div>
          </Prose>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

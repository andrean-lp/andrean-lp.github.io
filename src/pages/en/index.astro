---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '../../components/Prose.astro';
import { projects } from '../../data/projects';
import ProjectList from '../../components/ProjectList.astro';
import profile from '../../data/profile';
import Schema from '../../components/Schema.astro';
import FeaturedCaseStudy from '../../components/FeaturedCaseStudy.astro';
import FaqSection from '../../components/FaqSection.astro';
import DigitalProductsSection from '../../components/DigitalProductsSection.astro';

const top6Projects = projects.slice(0, 6);

const siteTitle = "Andre Wahyu Hermawan - Landing Page Strategist & CRO Specialist";
const siteDescription = "Professional portfolio of Andre Wahyu Hermawan — Landing Page Strategist & Conversion Rate Optimization Specialist helping global businesses maximize conversions and leads.";
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://andrean-lp.github.io';

// English Hero Bio
const bioEnglish = `
<p>I help high-growth businesses, founders, and creators turn their traffic into loyal paying clients with high-converting landing pages and data-backed Conversion Rate Optimization (CRO).</p>
<p>Specializing in direct-response design, clear copywriting hierarchy, and ultra-fast page speeds to deliver measurable ROI for your marketing campaigns.</p>
`;

// Schema.org: WebSite (English)
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Andre Wahyu Hermawan",
	"description": siteDescription,
	"url": `${siteUrl}/en/`,
	"inLanguage": "en",
	"publisher": {
		"@type": "Person",
		"name": profile.name || "Andre Wahyu Hermawan",
		"url": `${siteUrl}/en/about/`,
	}
};

const sameAs = [
	profile.github,
	profile.linkedin,
	profile.youtube,
	profile.instagram,
	profile.facebook,
	profile.pinterest,
].filter(Boolean);

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": profile.name || "Andre Wahyu Hermawan",
	"url": `${siteUrl}/en/about/`,
	"image": profile.avatar ? new URL(profile.avatar, Astro.site).toString() : undefined,
	"jobTitle": "Landing Page Strategist & CRO Specialist",
	"sameAs": sameAs.length > 0 ? sameAs : undefined,
};
---

<BaseLayout title={siteTitle} description={siteDescription}>
	<Schema item={websiteSchema} />
	<Schema item={personSchema} />
	<div class='container'>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
      <div class="text-pretty leading-9">
        <h1 class="text-4xl font-bold mb-4">Hi! I'm Andre Wahyu Hermawan 👋</h1>
        <Prose>
          <div class="text-lg space-y-4" set:html={bioEnglish}></div>
        </Prose>
      </div>
      {profile.avatar ? (
        <img 
          src={profile.avatar} 
          alt={profile.name || "Andre Wahyu Hermawan"} 
          width="300" 
          height="300" 
          loading="eager" 
          fetchpriority="high" 
          decoding="async" 
          class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover shadow-xl"
        />
      ) : (
        <Image 
          src={Ava} 
          alt={profile.name || "Andre Wahyu Hermawan"} 
          width={300} 
          height={300} 
          densities={[1, 1.5, 2]} 
          loading="eager" 
          decoding="async" 
          fetchpriority="high" 
          class="rounded-3xl rotate-3 mx-4 md:mx-0 w-[300px] h-[300px] aspect-square object-cover shadow-xl"
        />
      )}
		</div>

		<main>

      <FeaturedCaseStudy />

      <!-- Client Projects Section -->
      <div class="mb-14">
        <div class="flex justify-between items-center gap-2 mb-3">
          <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">Client Projects</h2>
          <a 
            href="/en/projects/" 
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-primary text-white hover:opacity-90 active:scale-[0.98] transition-all duration-200 shadow-2xs hover:shadow-xs group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-80 group-hover:scale-110 transition-transform">
              <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
            </svg>
            <span>All Projects</span>
          </a>
        </div>
        <ProjectList projects={top6Projects}/>
      </div>

      <!-- Digital Products Section -->
      <DigitalProductsSection />

      <!-- FAQ Section -->
      <FaqSection />
		</main>
	</div>
</BaseLayout>

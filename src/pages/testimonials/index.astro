---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schema from '../../components/Schema.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import TestimonialLightbox from '../../components/TestimonialLightbox.astro';
import testimonialsData from '../../data/testimonials.json';
import profile from '../../data/profile.json';
import site from '../../data/site.json';
import { SITE_TITLE } from '../../consts';

const title = testimonialsData.pageTitle || 'Kisah Sukses & Testimoni Klien';
const description = testimonialsData.pageSubtitle || 'Bukti nyata kepuasan klien dan hasil konversi dari proyek landing page serta optimasi bisnis bersama Andre Wahyu Hermawan.';

const items = testimonialsData.items || [];

// Ambil daftar kategori unik
const rawCategories = items.map((i: any) => i.category).filter(Boolean);
const categories = ['Semua', ...Array.from(new Set(rawCategories))];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://andrean-lp.github.io';
const pageUrl = `${siteUrl}/testimonials/`;

// WhatsApp CTA
const whatsappNumber = (site.whatsapp || '').replace(/[^0-9]/g, '');
const whatsappUrl = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=Halo%20Andre,%20saya%20tertarik%20untuk%20diskusi%20pembuatan%20landing%20page%20setelah%20melihat%20halaman%20testimoni%20Anda.` : null;

// Schema.org: CollectionPage & ItemList Review
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": pageUrl,
  "inLanguage": "id",
  "about": {
    "@type": "Person",
    "name": profile.name || SITE_TITLE,
    "url": siteUrl,
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": items.map((item: any, idx: number) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "item": {
        "@type": "Review",
        "name": item.title,
        "reviewBody": item.highlight || item.title,
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": item.rating || 5,
          "bestRating": 5,
        },
        "author": {
          "@type": "Person",
          "name": item.clientName || "Klien Terverifikasi",
        },
        "itemReviewed": {
          "@type": "Organization",
          "name": `${profile.name || SITE_TITLE} — Landing Page Strategist`,
        }
      }
    }))
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Testimoni",
      "item": pageUrl,
    }
  ]
};
---

<BaseLayout title={`${title} | ${profile.name || SITE_TITLE}`} description={description}>
  <Schema item={collectionSchema} />
  <Schema item={breadcrumbSchema} />

  <div class="container max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mb-6">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Beranda</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-40">
        <path d="m9 18 6-6-6-6"/>
      </svg>
      <span class="text-zinc-900 dark:text-zinc-100 font-medium">Testimoni</span>
    </nav>

    <!-- Header Section -->
    <div class="mb-8 sm:mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60 text-xs font-semibold mb-4 shadow-2xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Bukti & Hasil Nyata Klien</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100 mb-4">
        {title}
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Pinterest-Style Filter Bar -->
    <div class="mb-10">
      <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto no-scrollbar py-1" id="filter-container">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200 cursor-pointer ${
              idx === 0 
                ? 'bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shadow-sm' 
                : 'bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-700'
            }`}
            data-category={cat}
          >
            {cat}
            {cat === 'Semua' && (
              <span class="ml-1.5 opacity-70 text-[11px]">({items.length})</span>
            )}
          </button>
        ))}
      </div>
    </div>

    <!-- Masonry Grid Layout (Pinterest Style) -->
    <div 
      id="masonry-grid" 
      class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-5"
    >
      {items.map((item: any, idx: number) => (
        <TestimonialCard testimonial={item} index={idx} />
      ))}
    </div>

    <!-- Empty State (Hidden by default) -->
    <div id="empty-state" class="hidden text-center py-20">
      <div class="w-16 h-16 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-400 mx-auto flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="m15 9-6 6"/>
          <path d="m9 9 6 6"/>
        </svg>
      </div>
      <h3 class="font-bold text-lg text-zinc-800 dark:text-zinc-200">Tidak ada testimoni di kategori ini</h3>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Pilih kategori lain untuk melihat bukti ulasan lainnya.</p>
    </div>

    <!-- CTA Section -->
    <div class="mt-20 mb-10 p-8 sm:p-12 rounded-3xl bg-zinc-900 text-white dark:bg-zinc-900/90 dark:border dark:border-zinc-800 text-center relative overflow-hidden shadow-xl">
      <div class="max-w-xl mx-auto relative z-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3">
          Siap Merasakan Lonjakan Konversi Serupa?
        </h2>
        <p class="text-sm sm:text-base text-zinc-300 mb-8 leading-relaxed">
          Konsultasikan kebutuhan landing page atau audit funnel bisnis Anda secara gratis dan langsung bersama Andre Wahyu Hermawan.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3.5">
          {whatsappUrl && (
            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-6 py-3 bg-primary text-white rounded-xl font-semibold text-sm hover:opacity-90 active:scale-[0.98] transition-all shadow-md inline-flex items-center gap-2"
            >
              <span>Diskusi via WhatsApp</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          )}
          <a 
            href="/projects/" 
            class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white rounded-xl font-semibold text-sm transition-all border border-white/20"
          >
            Lihat Portofolio Client
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- Interactive Lightbox Modal -->
  <TestimonialLightbox />
</BaseLayout>

<script>
  (() => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = Array.from(document.querySelectorAll('.testimonial-card')) as HTMLElement[];
    const emptyState = document.getElementById('empty-state');

    // Parse all testimonial data from card DOM elements
    const allTestimonials = cards.map((card) => {
      try {
        return JSON.parse(card.getAttribute('data-testimonial') || '{}');
      } catch {
        return {};
      }
    });

    let currentVisibleItems = [...allTestimonials];

    // Card click opens Lightbox
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const rawIndex = Number(card.getAttribute('data-index')) || 0;
        const targetItem = allTestimonials[rawIndex];
        const visibleIdx = currentVisibleItems.indexOf(targetItem);

        if ((window as any).__openTestimonialLightbox) {
          (window as any).__openTestimonialLightbox(
            currentVisibleItems, 
            visibleIdx >= 0 ? visibleIdx : 0
          );
        }
      });
    });

    // Pinterest Filter Handler
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');
        if (!category) return;

        // Update Button Active States
        filterButtons.forEach((b) => {
          b.classList.remove('bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900', 'shadow-sm');
          b.classList.add('bg-white', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-300', 'border', 'border-zinc-200', 'dark:border-zinc-700');
        });
        btn.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-300', 'border', 'border-zinc-200', 'dark:border-zinc-700');
        btn.classList.add('bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900', 'shadow-sm');

        // Filter Cards
        currentVisibleItems = [];
        let visibleCount = 0;

        cards.forEach((card, idx) => {
          const cardCat = card.getAttribute('data-category');
          const isMatch = category === 'Semua' || cardCat === category;

          if (isMatch) {
            card.style.display = 'block';
            currentVisibleItems.push(allTestimonials[idx]);
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Show/hide empty state
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  })();
</script>

<style>
  /* Sembunyikan scrollbar pada container filter untuk tampilan rapi */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

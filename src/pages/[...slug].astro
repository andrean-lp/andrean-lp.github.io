---
import { type CollectionEntry, getCollection } from 'astro:content';
import Prose from '../components/Prose.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Schema from '../components/Schema.astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';

import TableOfContent from '../components/widgets/TableOfContent.astro';
import { slugify } from '../utils';
import { loadEnv } from 'vite';
import { render } from 'astro:content';
import profile from '../data/profile';
import { SITE_TITLE } from '../consts';
import Ava from '@src/assets/img/ava.jpg';

const { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CATEGORY, GISCUS_CATEGORY_ID } = loadEnv(process.env.NODE_ENV || 'production', process.cwd(), '');

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post: any) => ({
		params: { slug: post.id },
		props: post
	}));
}
type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const {
	data: { title, seoTitle, description, coverImage, pubDate, updatedDate, tags }
} = post;
const ogImage = typeof coverImage === 'string' ? coverImage : (coverImage?.src || undefined);
const { Content, headings } = await render(post);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://andrean-lp.github.io';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Schema.org: BlogPosting
const blogPostingSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"image": ogImage ? new URL(ogImage, Astro.site).toString() : undefined,
	"datePublished": pubDate.toISOString(),
	"dateModified": (updatedDate || pubDate).toISOString(),
	"author": {
		"@type": "Person",
		"name": profile.name || SITE_TITLE,
		"url": `${siteUrl}/about/`,
		"sameAs": [
			profile.github,
			profile.linkedin,
		].filter(Boolean),
	},
	"publisher": {
		"@type": "Person",
		"name": profile.name || SITE_TITLE,
		"url": siteUrl,
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": pageUrl,
	},
	"keywords": tags?.join(', ') || undefined,
	"inLanguage": "id",
};

// Schema.org: BreadcrumbList
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl,
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Posts",
			"item": `${siteUrl}/posts/`,
		},
		{
			"@type": "ListItem",
			"position": 3,
			"name": title,
			"item": pageUrl,
		}
	]
};
---

<BaseLayout
	title={seoTitle || title}
	description={description}
	image={ogImage}
	articleDate={pubDate}
	updatedDate={updatedDate}
	type="article"
	tags={tags}
>
	<Schema item={blogPostingSchema} />
	<Schema item={breadcrumbSchema} />
	<div class='container lg:flex gap-10'>
		<main
			class='overflow-hidden grow'
		>
			<article>
				<Prose>
					<div>
						<h1 class='!my-1 leading-tight'>{title}</h1>
            <div class='text-sm font-[500] mt-2 sm:mt-0 py-1 md:text-right flex flex-col sm:flex-row gap-3 sm:justify-between sm:items-center'>
              {
                <div class='flex gap-2'>
                  {
                    (tags || [] )?.map((tag: string) => (
                      <a
                        class='border border-zinc-300 dark:border-zinc-700 rounded-2xl
                          text-sm text-zinc-700 dark:text-zinc-300 no-underline px-2 py-0.5
                          transition-all duration-700
                        hover:border-zinc-700 dark:hover:border-zinc-300'
                        href={`/tags/${slugify(tag)}/`}>
                        {tag}
                      </a>
                    ))
                  }
                </div>
              }
              <div>
                {
                  updatedDate ?
                    <>Updated on <strong><FormattedDate date={updatedDate} /></strong></>
                  :
                    <>Published on <strong><FormattedDate date={pubDate} /></strong></>
                }
              </div>
            </div>
            
            <div class="flex items-center gap-4 mt-6 mb-2 not-prose">
              {profile.avatar ? (
                <img src={profile.avatar} alt={profile.name || SITE_TITLE} class="w-12 h-12 rounded-full object-cover m-0" width="48" height="48" loading="lazy" decoding="async" />
              ) : (
                <Image src={Ava} alt={profile.name || SITE_TITLE} class="w-12 h-12 rounded-full object-cover m-0" width={48} height={48} loading="lazy" decoding="async" />
              )}
              <div class="flex flex-col leading-tight justify-center">
                <span class="text-[10px] font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest mb-1">Ditulis Oleh</span>
                <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">{profile.name || SITE_TITLE}</span>
                {profile.role && <span class="text-sm text-slate-500 dark:text-slate-400">{profile.role}</span>}
              </div>
            </div>

					</div>
          <div class='py-3 overflow-hidden'>
            {coverImage && (
              typeof coverImage === 'string' ? (
                <img class='rounded-3xl w-full m-0 lg:mb-2 max-h-[500px] object-cover' src={coverImage} alt={title} loading='eager' decoding='async' />
              ) : (
                <Image class='rounded-3xl w-full m-0 lg:mb-2' src={coverImage} alt={title} loading='eager' decoding='async' />
              )
            )}
          </div>
					<Content />
				</Prose>
        {
          GISCUS_REPO &&
            <script
              id='giscus-script'
              is:inline
              src='https://giscus.app/client.js'
              data-repo={GISCUS_REPO}
              data-repo-id={GISCUS_REPO_ID}
              data-category={GISCUS_CATEGORY}
              data-category-id={GISCUS_CATEGORY_ID}
              data-mapping='pathname'
              data-strict='0'
              data-reactions-enabled='1'
              data-emit-metadata='0'
              data-input-position='bottom'
              data-theme='preferred_color_scheme'
              data-lang='en'
              data-loading='lazy'
              crossorigin='anonymous'
              async></script>
        }

			</article>
		</main>
    <div class='shrink-0 w-[280px] hidden md:block'>

			<TableOfContent headings={headings} />
		</div>
	</div>
</BaseLayout>

<script>
	function initTocScrollSpy() {
		const anchors = Array.from(document.querySelectorAll('.prose h2[id], .prose h3[id]')) as HTMLElement[];
		const links = Array.from(document.querySelectorAll('nav.toc a.toc-link')) as HTMLAnchorElement[];

		if (!anchors.length || !links.length) return;

		function observeToc() {
			const scrollY = window.scrollY;
			let currentActiveId = '';

			for (let i = 0; i < anchors.length; i++) {
				const anchor = anchors[i];
				// Offset to detect heading comfortably before reaching top of viewport
				if (scrollY >= anchor.offsetTop - 120) {
					currentActiveId = anchor.id;
				}
			}

			// If at very top of the page, or no heading reached yet
			links.forEach((link) => {
				const href = link.getAttribute('href');
				if (currentActiveId && href === '#' + currentActiveId) {
					link.classList.add('is-active');
				} else {
					link.classList.remove('is-active');
				}
			});
		}

		observeToc();
		window.addEventListener('scroll', observeToc, { passive: true });
		window.addEventListener('hashchange', observeToc);
	}

	initTocScrollSpy();
</script>
